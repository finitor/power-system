# Copy to .env on the Raspberry Pi or development machine and fill in locally.

CLASSIC_HOST=192.168.0.10
CLASSIC_PORT=502
CLASSIC_DEVICE_ID=10
SUPERVISOR_REFRESH_SECONDS=30
SUPERVISOR_DISPLAY_CLEAR=true
BATTERY_CAPACITY_AH=200

AMBIENT_SENSOR_ENABLED=true
AMBIENT_SENSOR_KIND=ds18b20
AMBIENT_DHT22_GPIO=4
AMBIENT_DS18B20_DEVICE_ID=
AMBIENT_LOG_PATH=/var/log/offgrid-power/ambient.csv

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=off-grid
INFLUXDB_BUCKET=power
INFLUXDB_TOKEN=

ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
