# Copy to .env on the Raspberry Pi or development machine and fill in locally.

CLASSIC_HOST=192.168.0.10
CLASSIC_PORT=502
CLASSIC_DEVICE_ID=10
SUPERVISOR_REFRESH_SECONDS=30
SUPERVISOR_DISPLAY_CLEAR=true
BATTERY_CAPACITY_AH=200
BATTERY_CAN_PROTOCOL=pylon

AMBIENT_SENSOR_ENABLED=true
AMBIENT_SENSOR_KIND=ds18b20
AMBIENT_DHT22_GPIO=4
AMBIENT_DS18B20_DEVICE_ID=
AMBIENT_LOG_PATH=/srv/offgrid/logs/ambient.csv

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=off-grid
INFLUXDB_BUCKET=power
INFLUXDB_TOKEN=

METRICS_DB_PATH=/srv/offgrid/data/metrics.sqlite
WEATHER_ENABLED=true
WEATHER_LATITUDE=48.000000
WEATHER_LONGITUDE=-84.000000
WEATHER_LABEL=cabin
WEATHER_REFRESH_MINUTES=30
WEATHER_CACHE_PATH=/srv/offgrid/data/weather-cache.json

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SITE_ID=cabin
R2_PREFIX=metrics
R2_ENDPOINT_URL=
R2_REGION=auto
R2_EXPORT_LIMIT=5000
R2_EXPORT_MAX_BATCHES=1
R2_EXPORT_SLEEP_SECONDS=0

B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=magpie-metrics
B2_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
B2_REGION=REGION
B2_SITE_ID=cabin
B2_PREFIX=metrics
B2_EXPORT_LIMIT=5000
B2_EXPORT_MAX_BATCHES=1
B2_EXPORT_SLEEP_SECONDS=0

ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
