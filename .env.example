# Copy to .env on the Raspberry Pi or development machine and fill in locally.

CLASSIC_HOST=192.168.0.10
CLASSIC_PORT=502
CLASSIC_DEVICE_ID=10
SUPERVISOR_REFRESH_SECONDS=30
SUPERVISOR_DISPLAY_CLEAR=true
BATTERY_CAPACITY_AH=200
BATTERY_CAN_PROTOCOL=pylon

AMBIENT_SENSOR_ENABLED=true
AMBIENT_SENSOR_KIND=ds18b20
AMBIENT_DHT22_GPIO=4
AMBIENT_DS18B20_DEVICE_ID=
AMBIENT_LOG_PATH=/srv/telemetry/logs/ambient.csv

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=off-grid
INFLUXDB_BUCKET=power
INFLUXDB_TOKEN=

METRICS_DB_PATH=/srv/telemetry/data/metrics.sqlite
WEATHER_ENABLED=true
WEATHER_LATITUDE=48.000000
WEATHER_LONGITUDE=-84.000000
WEATHER_LABEL=Cabin
WEATHER_REFRESH_MINUTES=30
WEATHER_CACHE_PATH=/srv/telemetry/data/weather-cache.json

# Object-store export (S3-compatible). Live target: Backblaze B2.
# The exporter also accepts S3_* equivalents for any other S3 provider.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=magpie-metrics
B2_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
B2_REGION=REGION
B2_SITE_ID=cabin
B2_PREFIX=metrics
B2_EXPORT_LIMIT=5000
B2_EXPORT_MAX_BATCHES=1
B2_EXPORT_SLEEP_SECONDS=0

ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# Charge-current allocator tuning (optional; unset = code defaults). The on/off
# TOGGLE is NOT here -- it's the --charge-allocation flag in the systemd unit, by
# design. These are tuning knobs only; see docs/charge-current-allocation.md
# "Operator controls" for the full table. CHARGE_ALLOC_<FIELD> overrides
# ChargeAllocatorConfig, CHARGE_CEILING_<FIELD> overrides ChargeCeilingConfig.
# CHARGE_ALLOC_RESERVE_A=5.0
# CHARGE_ALLOC_MIN_WRITE_DELTA_A=1.0
# CHARGE_ALLOC_TARGET_DEADBAND_A=5.0
# CHARGE_ALLOC_TARGET_QUANTUM_A=5.0
# CHARGE_ALLOC_CLASSIC_MAX_A=80
# CHARGE_ALLOC_EPEVER_MAX_A=100
# CHARGE_ALLOC_CLASSIC_SLEEP_DEBOUNCE_S=180
# CHARGE_ALLOC_EPEVER_SLEEP_DEBOUNCE_S=180
# CHARGE_CEILING_BMS_KNEE_CCL_BASELINE_A=200.0
# CHARGE_CEILING_BMS_CCL_BUDGET_FRACTION=0.5
# CHARGE_CEILING_HIGH_CELL_STOP_V=3.62
# CHARGE_CEILING_HIGH_CELL_SOFT_LIMIT_V=3.55
# CHARGE_CEILING_HIGH_DELTA_STOP_MV=150
