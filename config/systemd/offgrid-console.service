[Unit]
Description=Off-grid power terminal console
After=network-online.target offgrid-supervisor.service
Wants=network-online.target
BindsTo=offgrid-supervisor.service

[Service]
Type=simple
User=@OFFGRID_USER@
Group=@OFFGRID_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=CLASSIC_HOST=192.168.0.10
Environment=PYTHONPATH=@PROJECT_DIR@/software/pi-controller/src
EnvironmentFile=-/etc/offgrid-power.env
ExecStartPre=/bin/sh -c '/usr/bin/tmux kill-session -t offgrid-console 2>/dev/null || true'
ExecStart=@PROJECT_DIR@/scripts/run-console-tmux.sh
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
