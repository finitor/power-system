[Unit]
Description=Off-grid power supervisor display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@OFFGRID_USER@
Group=@OFFGRID_USER@
WorkingDirectory=/home/@OFFGRID_USER@/power-system
Environment=CLASSIC_HOST=192.168.0.10
Environment=PYTHONPATH=/home/@OFFGRID_USER@/power-system/software/pi-controller/src
EnvironmentFile=-/etc/offgrid-power.env
ExecStartPre=+/bin/sh -c '/usr/bin/ip link set can0 down 2>/dev/null || true'
ExecStartPre=+/usr/bin/ip link set can0 type can bitrate 500000 listen-only on
ExecStartPre=+/usr/bin/ip link set can0 up
ExecStart=/home/@OFFGRID_USER@/power-system/.venv/bin/python /home/@OFFGRID_USER@/power-system/scripts/supervisor-display.py --classic-host ${CLASSIC_HOST} --web-display --web-port 8080 --interval 5 --no-terminal-display --metrics-db-path data/metrics.sqlite --metrics-snapshot-interval 60 --metrics-settings-interval 3600
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
