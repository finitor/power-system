[Unit]
Description=Off-grid power supervisor display
After=network-online.target
Wants=network-online.target
# The console display BindsTo this unit, so it dies whenever the supervisor
# is stopped (e.g. to free the EPEver adapter for a direct write). Upholds
# makes systemd revive the console automatically once the supervisor is back,
# so a plain `systemctl start offgrid-supervisor` restores the desktop display.
Upholds=offgrid-console.service

[Service]
Type=simple
# Dedicated unprivileged service account (ensured by deploy.sh): the
# supervisor parses LAN HTTP, CAN frames, RS485, and internet weather
# responses, so it must not run as the interactive admin user.
User=@SERVICE_USER@
Group=@SERVICE_USER@
SupplementaryGroups=dialout gpio
WorkingDirectory=@PROJECT_DIR@
Environment=CLASSIC_HOST=192.168.0.10
Environment=PYTHONPATH=@PROJECT_DIR@/software/pi-controller/src
EnvironmentFile=-/etc/offgrid-power.env
# EPEver COM adapter via its udev symlink (config/udev/90-offgrid-usb.rules).
# Relies on only one CH340 (1a86:7523) on the bus at a time.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Ensure data and log directories exist; creates them on the SD card if /srv/telemetry is not mounted.
ExecStartPre=+/bin/mkdir -p /srv/telemetry/data /srv/telemetry/logs
ExecStartPre=+/bin/chown -R @SERVICE_USER@:@SERVICE_USER@ /srv/telemetry
# SD-side fallback store dir: written while the SSD is unmounted, merged back on recovery.
ExecStartPre=+/bin/mkdir -p /var/lib/offgrid
ExecStartPre=+/bin/chown @SERVICE_USER@:@SERVICE_USER@ /var/lib/offgrid
ExecStartPre=+/bin/sh -c '/usr/bin/ip link set can0 down 2>/dev/null || true'
ExecStartPre=+/usr/bin/ip link set can0 type can bitrate 500000 listen-only on
ExecStartPre=+/usr/bin/ip link set can0 up
ExecStart=@PROJECT_DIR@/.venv/bin/python @PROJECT_DIR@/scripts/supervisor-display.py --classic-host ${CLASSIC_HOST} --epever-device /dev/epever-rs485 --web-display --web-host 127.0.0.1 --web-port 8081 --weather --weather-cache-path /srv/telemetry/data/weather-cache.json --interval 5 --no-terminal-display --metrics-db-path /srv/telemetry/data/metrics.sqlite --metrics-db-mountpoint /srv/telemetry --metrics-fallback-db-path /var/lib/offgrid/metrics-fallback.sqlite --metrics-snapshot-interval 60 --charge-allocation
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
