[Unit]
Description=Off-grid power supervisor display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@OFFGRID_USER@
Group=@OFFGRID_USER@
WorkingDirectory=/home/@OFFGRID_USER@/power-system
Environment=CLASSIC_HOST=192.168.0.10
Environment=MAGNUM_DEVICE=/dev/ttyUSB0
Environment=PYTHONPATH=/home/@OFFGRID_USER@/power-system/software/pi-controller/src
EnvironmentFile=-/etc/offgrid-power.env
# Ensure data and log directories exist; creates them on the SD card if /srv/offgrid is not mounted.
ExecStartPre=+/bin/mkdir -p /srv/offgrid/data /srv/offgrid/logs
ExecStartPre=+/bin/chown -R @OFFGRID_USER@:@OFFGRID_USER@ /srv/offgrid
ExecStartPre=+/bin/sh -c '/usr/bin/ip link set can0 down 2>/dev/null || true'
ExecStartPre=+/usr/bin/ip link set can0 type can bitrate 500000 listen-only on
ExecStartPre=+/usr/bin/ip link set can0 up
ExecStart=/home/@OFFGRID_USER@/power-system/.venv/bin/python /home/@OFFGRID_USER@/power-system/scripts/supervisor-display.py --classic-host ${CLASSIC_HOST} --web-display --web-port 8081 --weather --weather-latitude 48.000000 --weather-longitude -84.000000 --weather-label cabin --weather-cache-path /srv/offgrid/data/weather-cache.json --interval 5 --no-terminal-display --web-access-log-path /srv/offgrid/logs/web-display-access.log --load-sample-log-path /srv/offgrid/data/load-samples.csv --metrics-db-path /srv/offgrid/data/metrics.sqlite --metrics-snapshot-interval 60 --metrics-settings-interval 3600 --ambient-log-path /srv/offgrid/logs/ambient.csv
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
