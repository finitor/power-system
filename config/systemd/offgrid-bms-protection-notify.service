[Unit]
Description=Report active BMS protection (hardware cutoff) to a dedicated Healthchecks.io channel
After=offgrid-supervisor.service

[Service]
Type=oneshot
# Unprivileged: only reads localhost /api/v1/health and posts to Healthchecks.
# systemd reads EnvironmentFile as root before dropping to the service user, so
# HC_BMS_PROTECTION_URL is available even though the env file is root-only.
User=@SERVICE_USER@
Group=@SERVICE_USER@
EnvironmentFile=-/etc/offgrid-power.env
ExecStart=@PROJECT_DIR@/scripts/bms-protection-notify.sh
