[Unit]
Description=Watch off-grid supervisor deployment for code changes

[Path]
PathModified=/home/@OFFGRID_USER@/power-system/software/pi-controller/src/offgrid_power
PathModified=/home/@OFFGRID_USER@/power-system/pyproject.toml
Unit=offgrid-supervisor-restart.service

[Install]
WantedBy=multi-user.target
