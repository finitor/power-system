[Unit]
Description=Export off-grid power metrics to object storage
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@OFFGRID_USER@
Group=@OFFGRID_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONPATH=@PROJECT_DIR@/software/pi-controller/src
EnvironmentFile=-/etc/offgrid-power.env
ExecStart=@PROJECT_DIR@/.venv/bin/python -m offgrid_power.cli.r2_export --max-batches 0
TimeoutStartSec=20min
