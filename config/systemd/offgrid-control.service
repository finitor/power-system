[Unit]
Description=Off-grid power control service
After=network-online.target offgrid-telemetry.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/off-grid-power-system/software/pi-controller
EnvironmentFile=-/etc/offgrid-power.env
ExecStart=/usr/bin/python3 -m offgrid_controller.control
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

