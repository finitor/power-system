#!/usr/bin/env bash
set -uo pipefail

# Composed wall console for the bare tty: left pane nest-attaches to the
# service-owned offgrid-console tmux session (the same re-attach loop the
# desktop window used), right pane is a plain shell ready at the keyboard.
#
# The outer session runs on its OWN tmux server (-L): the default-socket
# server is spawned by offgrid-console.service, so it sits in that
# service's cgroup and systemd kills it — including every session on it —
# on each service restart and deploy. On a dedicated socket the shell
# pane belongs to the tty login instead and survives all of that; the
# left pane just re-attaches when the service session comes back.

SOCKET="${OFFGRID_TTY_SOCKET:-offgrid-tty}"
SESSION="${OFFGRID_TTY_SESSION:-wall}"
# Keep the telemetry pane readable without starving the operator shell.
# The renderer can use up to 120 columns, but the 192-column tty created by
# the current console font feels better with roughly half the screen left for
# commands.
DISPLAY_COLS="${OFFGRID_TTY_DISPLAY_COLS:-96}"
FONT_TOOL="${HOME}/.local/bin/offgrid-console-font"

# Restore the operator's chosen font size before laying out panes, so the
# session is built at the right geometry. Boot loads the default (Terminus16).
[ -x "${FONT_TOOL}" ] && "${FONT_TOOL}" apply 2>/dev/null || true

ensure_session() {
  tmux -L "${SOCKET}" has-session -t "${SESSION}" 2>/dev/null && return 0
  # Size the detached session to this tty up front: pane geometry is laid
  # out before the first client attaches. TMUX= so the nested attach
  # inside the pane is allowed.
  tmux -L "${SOCKET}" new-session -d -s "${SESSION}" -n console \
    -x "$(tput cols)" -y "$(tput lines)" \
    "TMUX= exec ${HOME}/.local/bin/open-offgrid-console"
  # The inner session keeps its status line; a second one is clutter.
  tmux -L "${SOCKET}" set-option -t "${SESSION}" status off
  tmux -L "${SOCKET}" split-window -h -t "${SESSION}:console.0"
  # Land on the shell so the keyboard is immediately useful.
  tmux -L "${SOCKET}" select-pane -t "${SESSION}:console.1"
}

apply_layout() {
  tmux -L "${SOCKET}" resize-pane -t "${SESSION}:console.0" -x "${DISPLAY_COLS}" 2>/dev/null || true
  tmux -L "${SOCKET}" select-pane -t "${SESSION}:console.1" 2>/dev/null || true
}

# Font size hotkeys. Set on every startup — the tmux server outlives a
# console/getty restart, so binding only at session creation would miss it.
#
# F-keys are bound at the ROOT table (-n, no prefix): the display pane is a
# nested tmux, which makes the prefix dance unreliable from the physical
# keyboard, and the outer server intercepts root-table keys regardless of
# which pane has focus. Plain F-keys are safe here — they don't switch VTs and
# are never typed into the shell. F7 smaller, F8 bigger, F6 default. Prefix
# +/-/0 are also bound for anyone driving tmux directly.
setup_bindings() {
  [ -x "${FONT_TOOL}" ] || return 0
  tmux -L "${SOCKET}" bind-key -n F8 run-shell "${FONT_TOOL} up"
  tmux -L "${SOCKET}" bind-key -n F7 run-shell "${FONT_TOOL} down"
  tmux -L "${SOCKET}" bind-key -n F6 run-shell "${FONT_TOOL} reset"
  tmux -L "${SOCKET}" bind-key -r -T prefix + run-shell "${FONT_TOOL} up"
  tmux -L "${SOCKET}" bind-key -r -T prefix - run-shell "${FONT_TOOL} down"
  tmux -L "${SOCKET}" bind-key -T prefix 0 run-shell "${FONT_TOOL} reset"
}

while true; do
  ensure_session
  apply_layout
  setup_bindings
  tmux -L "${SOCKET}" attach -t "${SESSION}"
  sleep 2
done
