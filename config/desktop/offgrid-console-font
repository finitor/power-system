#!/usr/bin/env bash
set -euo pipefail

# Step the framebuffer console font up/down a preloaded size ladder.
#
# Console fonts are not scalable: "bigger" means loading a different PSF
# glyph file via setfont. All the sizes below ship with console-setup
# (/usr/share/consolefonts) so the step is just a setfont away. Every entry
# is a Uni2-TerminusBold variant: Bold gives heavier, less spindly strokes
# than plain Terminus, and Uni2 covers the glyphs the display needs beyond
# ASCII — the cell-delta U+0394 and the trend arrows U+2191/U+2193. See
# docs/runbooks/pi-64-bit-os-lite-migration.md. The chosen index is persisted
# so it survives console/service restarts and reboots.
#
# Changing the cell size reflows the tty geometry (the framebuffer is fixed at
# 1920x1080); tmux resizes its panes and the renderer adapts via its dynamic
# terminal-size read. Usage: offgrid-console-font {up|down|reset|apply}

# Small -> large. Index 2 (TerminusBold20x10, 10x20 cell -> 192x54) is the
# operator's chosen default: one step up from the 8x16 stock size for
# legibility on the wall panel. /etc/default/console-setup matches it.
LADDER=(
  Uni2-TerminusBold14      # 8x14
  Uni2-TerminusBold16      # 8x16  (stock)
  Uni2-TerminusBold20x10   # 10x20 (default)
  Uni2-TerminusBold24x12   # 12x24
  Uni2-TerminusBold28x14   # 14x28
  Uni2-TerminusBold32x16   # 16x32
)
DEFAULT_INDEX=2
TTY="${OFFGRID_CONSOLE_TTY:-/dev/tty1}"
STATE="${OFFGRID_CONSOLE_FONT_STATE:-${HOME}/.local/state/offgrid/console-font-index}"

mkdir -p "$(dirname "${STATE}")"
index="$(cat "${STATE}" 2>/dev/null || echo "${DEFAULT_INDEX}")"
case "${index}" in ''|*[!0-9]*) index="${DEFAULT_INDEX}" ;; esac

case "${1:-apply}" in
  up)    index=$((index + 1)) ;;
  down)  index=$((index - 1)) ;;
  reset) index="${DEFAULT_INDEX}" ;;
  apply) : ;;  # re-load the persisted size (used at console startup)
  *) echo "usage: $0 {up|down|reset|apply}" >&2; exit 2 ;;
esac

last=$(( ${#LADDER[@]} - 1 ))
[ "${index}" -lt 0 ] && index=0
[ "${index}" -gt "${last}" ] && index="${last}"

sudo setfont -C "${TTY}" "${LADDER[${index}]}"
echo "${index}" > "${STATE}"
# Breadcrumb so a keypress that reaches the binding is provable even though
# the size change is only visible on the physical panel.
printf '%s %s -> [%s] %s\n' "$(date -Is)" "${1:-apply}" "${index}" "${LADDER[${index}]}" \
  >> "$(dirname "${STATE}")/console-font.log" 2>/dev/null || true
